# PURE WARDRIVER CP-ADV build environment (SAMPLE).
# Copy to arduino-cli.yaml in THIS directory and adjust the paths:
#   cp sketchbooks/CP-ADV/arduino-cli.yaml.sample sketchbooks/CP-ADV/arduino-cli.yaml
directories:
  data: C:/pw-env/cpadv-data
  user: C:/path/to/PURE-WARDRIVER/sketchbooks/CP-ADV
board_manager:
  additional_urls:
    - https://github.com/espressif/arduino-esp32/releases/download/2.0.11/package_esp32_dev_index.json
